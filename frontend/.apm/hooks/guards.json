{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "pnpm exec factory guard", "timeout": 30 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "pnpm exec factory gate", "timeout": 600 }] }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "pnpm exec factory gate --helper", "timeout": 600 }
        ]
      }
    ]
  }
}
