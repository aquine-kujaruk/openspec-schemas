{
  "compilerOptions": {
    "target": "es2023",
    "paths": { "factory/sdk": ["./factory/sdk.ts"] },
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["schemas", "factory", "test", "tools", "packages", "*.ts"],
  "exclude": ["node_modules", "dist", "**/*.feature.test.ts"]
}
