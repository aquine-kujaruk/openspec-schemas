{
  "name": "openspec-schemas",
  "version": "0.14.2",
  "private": true,
  "description": "OpenSpec schemas, the resources they are built from and the packages built from them.",
  "type": "module",
  "bin": {
    "factory": "./factory/main.ts"
  },
  "exports": {
    ".": "./factory/shared/domain/schemas/configuration.schema.ts",
    "./package.json": "./package.json",
    "./sdk": "./factory/sdk.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm exec factory generate --check && pnpm run test"
  },
  "dependencies": {
    "@cucumber/gherkin": "42.0.1",
    "@fission-ai/openspec": "2.0.0",
    "archunit": "2.5.4",
    "fallow": "3.34.1",
    "feat2test": "4.0.0",
    "opsx-gherkin": "1.0.1",
    "oxlint": "1.93.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ejs": "3.1.5",
    "@types/node": "26.6.5",
    "ejs": "7.0.2",
    "factory": "link:.",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
